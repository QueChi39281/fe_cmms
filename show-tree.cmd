@echo off
setlocal
cd /d "%~dp0"
set "OUTPUT=%~dp0PROJECT_TREE.md"
echo Exporting project structure to PROJECT_TREE.md...
powershell.exe -NoProfile -Command "$root = (Get-Location).Path; $lines = @('# FixFlow project directory tree', '', 'Generated by show-tree.cmd. Excludes node_modules, .git, and dist.', '', '```text'); $lines += Get-ChildItem -LiteralPath $root -Force -Recurse -ErrorAction SilentlyContinue | Where-Object { $_.FullName -notmatch '[\\/](node_modules|\.git|dist)([\\/]|$)' } | Sort-Object FullName | ForEach-Object { $relative = $_.FullName.Substring($root.Length).TrimStart('\'); $depth = ($relative -split '[\\/]').Length - 1; $entry = if ($_.PSIsContainer) { $_.Name + '\' } else { $_.Name }; ('  ' * $depth) + $entry }; $lines += '```'; $lines | Set-Content -LiteralPath $env:OUTPUT -Encoding UTF8"
echo Done. The complete project tree is saved in:
echo %OUTPUT%
